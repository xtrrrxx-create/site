# Copy to .env for local admin (never commit .env)

# Optional: require this header (X-Admin-Token) on write API routes (POST/PUT/DELETE/reorder).
# Leave empty for local-only dev without a token.
ADMIN_API_TOKEN=

# Optional: password gate — max 5 attempts / 15 min per IP on POST /api/admin/authenticate
# Must be set together with ADMIN_API_TOKEN to enable login flow.
ADMIN_PASSWORD=

# Trust X-Forwarded-For for rate limits (set 1 behind a reverse proxy)
ADMIN_TRUST_X_FORWARDED=0

# Require token even for GET /api/products and /api/meta (optional hardening)
ADMIN_REQUIRE_TOKEN_FOR_READ=0

# Max JSON body size for API (bytes)
ADMIN_MAX_BODY_BYTES=262144

# Max HTTP requests per IP per minute (any path; blocks noisy scanners / cheap floods)
ADMIN_GLOBAL_RPM=400

# WebSocket: max new handshakes per IP per minute, max concurrent sockets per IP
ADMIN_WS_ACCEPT_PER_MIN=15
ADMIN_WS_MAX_PER_IP=6

# CORS: comma-separated origins, or leave empty for * (dev only)
ADMIN_CORS_ORIGINS=

# Auto git push after catalog save (0 to disable)
ADMIN_AUTO_GIT_PUSH=1

# Scripts (auto_import.py): default affiliate code in generated URLs
KAKOBUY_AFFCODE=keviinn

# ── Vercel serverless functions (set in Vercel dashboard, NOT committed) ──
# /api/products proxy — Supabase project URL + anon (RLS-enforced) key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# /api/qc proxy — Picksly partner key. NEVER expose to the browser.
PICKSLY_API_KEY=

